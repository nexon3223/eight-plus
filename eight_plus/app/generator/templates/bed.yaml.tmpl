# ─────────────────────────────────────────────────────────────────────────────
# Eight+ — shared bed entities (one per bed, whoever sleeps in it).
# GENERATED by the Eight+ add-on (v${VERSION}). Re-running the installer rewrites
# this file — copy anything you want to customise into your own package first.
# Backend: ${BACKEND_LABEL}
# ─────────────────────────────────────────────────────────────────────────────
#if two_climates
input_boolean:
  # Solo (off) = the primary sleeper's schedule/Autopilot drives BOTH halves.
  # Dual (on)  = each sleeper's automations drive only their own half.
  eight_plus_dual_mode:
    name: "Eight+ Dual mode"
    icon: mdi:bed-double-outline
#endif

template:
  - binary_sensor:
      # Normalised across backends so every automation reads one entity.
      - name: "Eight Plus Water Low"
        unique_id: eight_plus_water_low
        device_class: problem
        icon: mdi:water-alert
        state: "{{ ${WATER_LOW_TPL} }}"
      - name: "Eight Plus Priming"
        unique_id: eight_plus_priming
        device_class: running
        icon: mdi:water-sync
        state: "{{ ${PRIMING_TPL} }}"
#if room_temp

sensor:
  # Room warming/cooling rate — Autopilot's "reactive" term reads this.
  - platform: derivative
    name: "Eight Plus Room Temp Rate"
    unique_id: eight_plus_room_temp_rate
    source: ${ROOM_T}
    unit_time: h
    time_window: "00:30:00"
    round: 2
#endif
#if gateway

script:
  # Bed vibration through the Eight+ Pod gateway (franken proxy -> Sensor MCU motors).
  # power 0 = stop. The card's Developer > Vibration themes and the wake-up escalation use it.
  eight_sleep_pod_vibrate:
    alias: "Eight Sleep Pod · Vibrate"
    icon: mdi:vibrate
    mode: queued
    max: 5
    fields:
      side:
        name: Side
        default: left
        selector:
          select:
            options: [left, right]
      power:
        name: Power %
        default: 50
        selector:
          number: {min: 0, max: 100, step: 5}
      duration:
        name: Seconds
        default: 10
        selector:
          number: {min: 1, max: 600}
      pattern:
        name: Pattern
        default: double
        selector:
          select:
            options: [double, rise]
    sequence:
      - action: mqtt.publish
        data:
          topic: "eightpod/ctl/cmd/{{ 'right' if side == 'right' else 'left' }}_alarm"
          payload: >-
            {% if (power | int(0)) <= 0 %}off{% else %}{{ {'power': [power | int(50), 100] | min,
            'duration': [duration | int(10), 600] | min,
            'pattern': ('rise' if pattern == 'rise' else 'double')} | to_json }}{% endif %}
#endif
#if gateway and notify_primary

automation:
  - id: eight_plus_pod_health_alert
    alias: "Eight+ · Pod health alert"
    description: >-
      Push when the on-Pod watchdog reports the Pod broken, repairing itself, rebooting or
      offline — and when it's back.
    triggers:
      - trigger: state
        entity_id: sensor.eight_sleep_pod_health
        to: error
        for: {minutes: 1}
        id: error
      - trigger: state
        entity_id: sensor.eight_sleep_pod_health
        to: recovering
        id: recovering
      - trigger: state
        entity_id: sensor.eight_sleep_pod_health
        to: rebooting
        id: rebooting
      - trigger: state
        entity_id: sensor.eight_sleep_pod_health
        to: unavailable
        for: {minutes: 5}
        id: offline
      - trigger: state
        entity_id: sensor.eight_sleep_pod_health
        from: [error, recovering, rebooting, unavailable]
        to: ok
        id: ok
    actions:
      - action: ${NOTIFY_PRIMARY}
        data:
          title: "{{ titles[trigger.id] }}"
          message: >-
            {% if trigger.id == 'offline' %}The watchdog has stopped reporting — check the Pod has power and Wi-Fi.{% elif trigger.id == 'ok' %}Temperature control is running again.{% else %}{{ state_attr('sensor.eight_sleep_pod_health', 'summary') }}{% endif %}
          data:
            tag: eight_plus_pod_health
            group: pod
    mode: restart
    variables:
      titles:
        error: Pod needs attention
        recovering: Pod is repairing itself
        rebooting: Pod is restarting
        offline: Pod is offline
        ok: Pod is back to normal
#endif
