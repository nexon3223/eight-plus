# ─────────────────────────────────────────────────────────────────────────────
# Eight+ — ${NAME} (${SIDE} side${ROLE_NOTE})
# GENERATED by the Eight+ add-on (v${VERSION}). Re-running the installer rewrites
# this file — copy anything you want to customise into your own package first.
# Every entity here shares one prefix: ${P}
# ─────────────────────────────────────────────────────────────────────────────
${HELPERS_YAML}
template:
  - sensor:
      # The bed surface temperature as a plain sensor, whatever the backend calls it.
      - name: "Eight Sleep ${NAME} Bed Temperature"
        unique_id: ${P}_bed_temperature
        unit_of_measurement: "°C"
        device_class: temperature
        state_class: measurement
        availability: "{{ ${BED_TEMP_AVAIL} }}"
        state: "{{ ${BED_TEMP_TPL} }}"
#if autopilot

      # Autopilot's suggestion. The model lives in custom_templates/eight_plus.jinja.
      - name: "Eight Sleep ${NAME} Suggested Temp"
        unique_id: ${P}_suggested_temp
        unit_of_measurement: "°C"
        icon: mdi:thermostat-auto
        state: >-
          {% from 'eight_plus.jinja' import es_suggest %}
          {{ (es_suggest(${SUGGEST_ARGS}) | from_json).state }}
        attributes:
          env_base: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).env_base }}
          rate: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).rate }}
          lead_min: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).lead_min }}
          boost: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).boost }}
          phase: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).phase }}
          preheat_bonus: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).preheat_bonus }}
          phase_adj: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).phase_adj }}
          ramped_adj: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).ramped_adj }}
          response: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).response }}
          clamp_lo: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).clamp_lo }}
          clamp_hi: >-
            {% from 'eight_plus.jinja' import es_suggest %}{{ (es_suggest(${SUGGEST_ARGS}) | from_json).clamp_hi }}
#endif
#if coach

      # Sleep Coach — ONE word for "tonight" (off/away/waking/asleep/on_track/drifting/behind)
      # plus the computed times. The nightly arithmetic (debt, streaks) is derived by the card.
      - name: "Eight Sleep ${NAME} Coach Status"
        unique_id: ${P}_coach_status
        icon: mdi:shield-check
        state: >-
          {% set tonight = (state_attr('input_datetime.${P}_coach_tonight_target','timestamp')|int(0)) // 60 %}
          {% set wknd = now().weekday() in [4, 5] %}
          {% set bed_e = 'input_datetime.${P}_target_bedtime_weekend' if wknd else 'input_datetime.${P}_target_bedtime' %}
          {% set wake_e = 'input_datetime.${P}_target_wake_weekend' if wknd else 'input_datetime.${P}_target_wake' %}
          {% set plain = (state_attr(bed_e,'timestamp')|int(0)) // 60 %}
          {% set target = tonight if tonight > 0 else plain %}
          {% set wake = (state_attr(wake_e,'timestamp')|int(0)) // 60 %}
          {% set lead = states('input_number.${P}_winddown_lead')|int(45) %}
          {% set n = now().hour * 60 + now().minute %}
          {% set late = (n - target) % 1440 %}
          {% set to_target = (target - n) % 1440 %}
          {% set since_wake = (n - wake) % 1440 %}
          {% if is_state('input_boolean.${P}_coach','off') %}off
          {% elif is_state('${AWAY}','on') %}away
          {% elif since_wake < 25 and not is_state('input_select.${P}_wake_strength','Off')
                  and is_state('input_boolean.${P}_wake_ack','off')
                  and is_state('binary_sensor.${P}_in_bed','on') %}waking
          {% elif is_state('binary_sensor.${P}_in_bed','on') %}asleep
          {% elif late < 300 %}behind
          {% elif to_target <= lead %}drifting
          {% else %}on_track{% endif %}
        attributes:
          target: >-
            {% set tonight = (state_attr('input_datetime.${P}_coach_tonight_target','timestamp')|int(0)) // 60 %}
            {% set bed_e = 'input_datetime.${P}_target_bedtime_weekend' if now().weekday() in [4, 5] else 'input_datetime.${P}_target_bedtime' %}
            {% set plain = (state_attr(bed_e,'timestamp')|int(0)) // 60 %}
            {% set t = tonight if tonight > 0 else plain %}
            {{ '%02d:%02d' % (t // 60, t % 60) }}
          winddown: >-
            {% set tonight = (state_attr('input_datetime.${P}_coach_tonight_target','timestamp')|int(0)) // 60 %}
            {% set bed_e = 'input_datetime.${P}_target_bedtime_weekend' if now().weekday() in [4, 5] else 'input_datetime.${P}_target_bedtime' %}
            {% set plain = (state_attr(bed_e,'timestamp')|int(0)) // 60 %}
            {% set t = tonight if tonight > 0 else plain %}
            {% set w = (t - states('input_number.${P}_winddown_lead')|int(45)) % 1440 %}
            {{ '%02d:%02d' % (w // 60, w % 60) }}
          wake: >-
            {% set wake_e = 'input_datetime.${P}_target_wake_weekend' if now().weekday() in [4, 5] else 'input_datetime.${P}_target_wake' %}
            {% set w = (state_attr(wake_e,'timestamp')|int(0)) // 60 %}
            {{ '%02d:%02d' % (w // 60, w % 60) }}
          minutes_late: >-
            {% set tonight = (state_attr('input_datetime.${P}_coach_tonight_target','timestamp')|int(0)) // 60 %}
            {% set bed_e = 'input_datetime.${P}_target_bedtime_weekend' if now().weekday() in [4, 5] else 'input_datetime.${P}_target_bedtime' %}
            {% set plain = (state_attr(bed_e,'timestamp')|int(0)) // 60 %}
            {% set t = tonight if tonight > 0 else plain %}
            {% set late = (now().hour * 60 + now().minute - t) % 1440 %}
            {{ late if late < 300 else 0 }}
          weekend: "{{ now().weekday() in [4, 5] }}"
          in_bed: "{{ is_state('binary_sensor.${P}_in_bed','on') }}"
          nudges_sent: "{{ states('counter.${P}_coach_nudges')|int(0) }}"
#endif

  - binary_sensor:
      # Debounced "in bed": presence on for >= 40 % of the last 15 minutes. Raw bed presence
      # blips while the bed is empty and drops briefly through a real night; a plain
      # delay_off never settles. Replayed on real nights: one clean block, off ~10 min after
      # getting up.
      - name: "Eight Sleep ${NAME} In Bed"
        unique_id: ${P}_in_bed
        device_class: occupancy
        icon: mdi:bed
        availability: "{{ has_value('sensor.${P}_bed_occupancy_15m') }}"
        state: "{{ states('sensor.${P}_bed_occupancy_15m') | float(0) >= 40 }}"

sensor:
  - platform: history_stats
    name: "Eight Sleep ${NAME} Bed Occupancy 15m"
    unique_id: ${P}_bed_occupancy_15m
    entity_id: ${PRESENCE}
    state: "on"
    type: ratio
    end: "{{ now() }}"
    duration: {minutes: 15}
  # How fast the bed surface is warming/cooling — Autopilot's pre-conditioning uses it.
  - platform: derivative
    name: "Eight Sleep ${NAME} Bed Temp Rate"
    unique_id: ${P}_bed_temp_rate
    source: sensor.${P}_bed_temperature
    unit_time: h
    time_window: "00:10:00"
    round: 2

script:
  # The card's Wind down tile: bed to the wind-down temperature, sunrise light armed,
  # plus your own scene/script if you picked one. The delay IS the wind-down.
  ${P}_wind_down:
    alias: "Eight+ · ${NAME} · Wind down"
    icon: mdi:weather-night
    mode: restart
    sequence:
      - variables:
          beds: "{{ ${BEDS} }}"
          temp: "{{ states('input_number.${P}_winddown_level') | float(29) }}"
      - action: climate.turn_on
        target: {entity_id: "{{ beds }}"}
        continue_on_error: true
      - action: climate.set_temperature
        target: {entity_id: "{{ beds }}"}
        data: {temperature: "{{ temp }}"}
#if winddown_scene
      - action: ${WINDDOWN_SCENE_ACTION}
        target: {entity_id: ${WINDDOWN_SCENE}}
        continue_on_error: true
#endif
#if led
      - action: light.turn_on
        target: {entity_id: light.eight_sleep_pod_front_led}
        data: {rgb_color: [255, 110, 20], brightness: 50}
        continue_on_error: true
#endif
      - action: input_boolean.turn_on
        target: {entity_id: input_boolean.${P}_light_alarm}
        continue_on_error: true
      - delay: {minutes: 20}
#if led
      - action: light.turn_off
        target: {entity_id: light.eight_sleep_pod_front_led}
        continue_on_error: true
#endif

automation:
#if autopilot
  # ── Autopilot ─────────────────────────────────────────────────────────────
  - id: ${P}_autopilot_schedule
    alias: "Eight+ · ${NAME} · Autopilot schedule"
    description: >-
      Applies ${NAME}'s schedule at each phase time from the phase's temperature helper.
      Runs only while Smart Autopilot is off.${SOLO_DUAL_NOTE}
    triggers:
      - {trigger: time, at: input_datetime.${P}_bedtime, id: bedtime}
      - {trigger: time, at: input_datetime.${P}_winddown, id: winddown}
      - {trigger: time, at: input_datetime.${P}_early, id: early}
      - {trigger: time, at: input_datetime.${P}_late, id: late}
      - {trigger: time, at: input_datetime.${P}_deep, id: deep}
      - {trigger: time, at: input_datetime.${P}_prewake, id: prewake}
      - {trigger: time, at: input_datetime.${P}_wake, id: wake}
    conditions:
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_smart_autopilot, state: "off"}
#if secondary
      - {condition: state, entity_id: input_boolean.eight_plus_dual_mode, state: "on"}
#endif
    actions:
      - if:
          - {condition: trigger, id: bedtime}
        then:
          - action: climate.turn_on
            target: {entity_id: "{{ ${BEDS} }}"}
      - action: climate.set_temperature
        target: {entity_id: "{{ ${BEDS} }}"}
        data: {temperature: "{{ states('input_number.${P}_' ~ trigger.id ~ '_level') | float(28) }}"}
    mode: queued
    max: 4

  - id: ${P}_smart_autopilot_apply
    alias: "Eight+ · ${NAME} · Smart Autopilot apply"
    description: >-
      While Smart Autopilot is on, drives ${NAME}'s side to sensor.${P}_suggested_temp.
      A one-minute tick is gated by input_number.${P}_ap_tick, and a write only goes out when
      the suggestion differs from the setpoint by input_number.${P}_ap_deadband. Arming,
      bedtime and wake always force a write (wake yields to an active boost / wake-up heat).
    triggers:
      - {trigger: state, entity_id: sensor.${P}_suggested_temp, id: suggest}
      - {trigger: state, entity_id: input_boolean.${P}_smart_autopilot, to: "on", id: enable}
      - {trigger: time_pattern, minutes: /1, id: tick}
      - {trigger: time, at: input_datetime.${P}_bedtime, id: bedtime_on}
      - {trigger: time, at: input_datetime.${P}_wake, id: wake_on}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_smart_autopilot, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
#if secondary
      - {condition: state, entity_id: input_boolean.eight_plus_dual_mode, state: "on"}
#endif
    actions:
      - choose:
          - conditions:
              - {condition: trigger, id: [enable, bedtime_on, wake_on]}
              - alias: Wake write yields to the wake-up heat / a boost
                condition: or
                conditions:
                  - condition: not
                    conditions: [{condition: trigger, id: wake_on}]
                  - {condition: state, entity_id: input_boolean.${P}_boost_active, state: "off"}
            sequence:
              - action: climate.turn_on
                target: {entity_id: "{{ ${BEDS} }}"}
              - action: climate.set_temperature
                target: {entity_id: "{{ ${BEDS} }}"}
                data: {temperature: "{{ states('sensor.${P}_suggested_temp') | float(28) }}"}
        default:
          - {condition: state, entity_id: input_boolean.${P}_boost_active, state: "off"}
          - condition: not
            conditions: [{condition: state, entity_id: ${CLIMATE}, state: "off"}]
          - condition: template
            value_template: >-
              {{ trigger.id != 'tick' or (now().minute % ([states('input_number.${P}_ap_tick') | int(2), 1] | max)) == 0 }}
          - condition: template
            value_template: >-
              {{ (states('sensor.${P}_suggested_temp') | float(28) - state_attr('${CLIMATE}','temperature') | float(-99)) | abs >= (states('input_number.${P}_ap_deadband') | float(0.25)) }}
          - action: climate.set_temperature
            target: {entity_id: "{{ ${BEDS} }}"}
            data: {temperature: "{{ states('sensor.${P}_suggested_temp') | float(28) }}"}
    mode: queued
    max: 4

  - id: ${P}_auto_off
    alias: "Eight+ · ${NAME} · Auto-off"
    description: Turns the bed off at the set time when Auto-off is enabled.${SOLO_DUAL_NOTE}
    triggers:
      - {trigger: time, at: input_datetime.${P}_auto_off}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_auto_off_enabled, state: "on"}
#if secondary
      - {condition: state, entity_id: input_boolean.eight_plus_dual_mode, state: "on"}
#endif
    actions:
      - action: climate.turn_off
        target: {entity_id: "{{ ${BEDS} }}"}
    mode: single

  - id: ${P}_routine_apply
    alias: "Eight+ · ${NAME} · Routine apply (weekday/weekend)"
    description: >-
      The weekly routine is the source of truth for tonight's bedtime and wake. Copies the
      active day-type (weekend = Fri/Sat nights) into the schedule, and shifts the rest of the
      night with it so its shape is kept. Runs at 5 pm, on routine edits and on HA start.
    triggers:
      - {trigger: time, at: "17:00:00", id: tick}
      - trigger: state
        entity_id:
          - input_datetime.${P}_weekday_bedtime
          - input_datetime.${P}_weekday_alarm
          - input_datetime.${P}_weekend_bedtime
          - input_datetime.${P}_weekend_alarm
        id: edit
      - {trigger: homeassistant, event: start, id: boot}
    actions:
      - alias: Shift the evening/night phases by the bedtime move
        if:
          - {condition: template, value_template: "{{ d_bed | int != 0 }}"}
        then:
          - repeat:
              for_each:
                - input_datetime.${P}_winddown
                - input_datetime.${P}_early
                - input_datetime.${P}_late
                - input_datetime.${P}_deep
              sequence:
                - action: input_datetime.set_datetime
                  target: {entity_id: "{{ repeat.item }}"}
                  data:
                    time: >-
                      {% set t = (state_attr(repeat.item, 'timestamp') | int(0) + d_bed | int) % 86400 %}{{ '%02d:%02d:00' % (t // 3600, (t % 3600) // 60) }}
      - action: input_datetime.set_datetime
        target: {entity_id: input_datetime.${P}_bedtime}
        data: {time: "{{ states(bed_ent) }}"}
      - alias: Shift pre-wake and auto-off by the wake move
        if:
          - {condition: template, value_template: "{{ d_wake | int != 0 }}"}
        then:
          - repeat:
              for_each:
                - input_datetime.${P}_prewake
                - input_datetime.${P}_auto_off
              sequence:
                - action: input_datetime.set_datetime
                  target: {entity_id: "{{ repeat.item }}"}
                  data:
                    time: >-
                      {% set t = (state_attr(repeat.item, 'timestamp') | int(0) + d_wake | int) % 86400 %}{{ '%02d:%02d:00' % (t // 3600, (t % 3600) // 60) }}
      - action: input_datetime.set_datetime
        target: {entity_id: input_datetime.${P}_wake}
        data: {time: "{{ states(alarm_ent) }}"}
    variables:
      we: "{{ now().weekday() in [4, 5] }}"
      bed_ent: "{{ 'input_datetime.${P}_weekend_bedtime' if we else 'input_datetime.${P}_weekday_bedtime' }}"
      alarm_ent: "{{ 'input_datetime.${P}_weekend_alarm' if we else 'input_datetime.${P}_weekday_alarm' }}"
      old_bed: "{{ state_attr('input_datetime.${P}_bedtime', 'timestamp') | int(0) }}"
      new_bed: "{{ state_attr(bed_ent, 'timestamp') | int(0) }}"
      old_wake: "{{ state_attr('input_datetime.${P}_wake', 'timestamp') | int(0) }}"
      new_wake: "{{ state_attr(alarm_ent, 'timestamp') | int(0) }}"
      d_bed: "{{ ((new_bed - old_bed + 43200) % 86400) - 43200 }}"
      d_wake: "{{ ((new_wake - old_wake + 43200) % 86400) - 43200 }}"
    mode: queued
    max: 3

  - id: ${P}_boost_failsafe
    alias: "Eight+ · ${NAME} · Boost failsafe clear"
    description: >-
      Ends a card-started boost server-side: at boost_until, after 45 min stuck on, or on HA
      start — so a closed tab or restart can't leave Autopilot suppressed.
    triggers:
      - {trigger: time, at: input_datetime.${P}_boost_until, id: reached}
      - {trigger: state, entity_id: input_boolean.${P}_boost_active, to: "on", for: {minutes: 45}, id: stuck}
      - {trigger: homeassistant, event: start, id: boot}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_boost_active, state: "on"}
    actions:
      - action: input_boolean.turn_off
        target: {entity_id: input_boolean.${P}_boost_active}
    mode: single

  - id: ${P}_away_pause
    alias: "Eight+ · ${NAME} · Away mode pauses the bed"
    description: While Away is on, keep ${NAME}'s side off — and switch it off again if anything turns it on.
    triggers:
      - {trigger: state, entity_id: ${AWAY}, to: "on", id: enable}
      - {trigger: state, entity_id: ${CLIMATE}, from: "off", id: pod_turned_on}
    conditions:
      - {condition: state, entity_id: ${AWAY}, state: "on"}
    actions:
      - action: climate.turn_off
        target: {entity_id: ${CLIMATE}}
    mode: queued
    max: 5

  - id: ${P}_off_when_up
    alias: "Eight+ · ${NAME} · Off when I get up"
    description: >-
      Turns the bed off once ${NAME} has really got up: out of bed 5 min (debounced), after
      3 h+ in bed, 4 am–2 pm, and no earlier than 90 min before the wake phase unless they've
      been up 45 min.
    triggers:
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, from: "on", to: "off", for: {minutes: 5}, id: up}
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, from: "on", to: "off", for: {minutes: 45}, id: up_long}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_off_when_up, state: "on"}
      - condition: template
        value_template: "{{ ${ANY_ON} }}"
      - condition: template
        value_template: "{{ (as_timestamp(trigger.to_state.last_changed) - as_timestamp(trigger.from_state.last_changed)) >= 3 * 3600 }}"
      - condition: template
        value_template: >-
          {% set m = now().hour * 60 + now().minute %}{% set w = (state_attr('input_datetime.${P}_wake', 'hour') | int(8)) * 60 + (state_attr('input_datetime.${P}_wake', 'minute') | int(0)) %}{{ 240 <= m <= 840 and (trigger.id == 'up_long' or m >= w - 90) }}
    actions:
      - action: climate.turn_off
        target: {entity_id: "{{ ${BEDS} }}"}
#if notify
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: Bed off
          message: "You got up around {{ (as_local(trigger.to_state.last_changed) - timedelta(minutes=10)).strftime('%-I:%M %p') | lower }}, so the bed is off."
          data: {tag: ${P}_off_when_up}
#endif
    mode: single

  - id: ${P}_sunrise_light
    alias: "Eight+ · ${NAME} · Wake-up light (sunrise)"
    description: >-
      15 min before wake, ramps the light chosen in the card (input_text.${P}_alarm_light) from
      deep red 1 % to warm white 70 %. Enabled with input_boolean.${P}_light_alarm.
    triggers:
      - trigger: time
        at: {entity_id: input_datetime.${P}_wake, offset: "-00:15:00"}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_light_alarm, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - "{{ states('input_text.${P}_alarm_light').startswith('light.') }}"
    actions:
      - variables:
          wl: "{{ states('input_text.${P}_alarm_light') }}"
          steps: 14
      - action: light.turn_on
        target: {entity_id: "{{ wl }}"}
        data: {rgb_color: [255, 15, 0], brightness_pct: 1}
      - repeat:
          count: "{{ steps }}"
          sequence:
            - delay: {seconds: 60}
            - action: light.turn_on
              target: {entity_id: "{{ wl }}"}
              data:
                brightness_pct: "{{ (1 + repeat.index * 69 / steps) | round }}"
                rgb_color:
                  - 255
                  - "{{ (15 + repeat.index * (197 - 15) / steps) | round }}"
                  - "{{ (repeat.index * 143 / steps) | round }}"
      - action: light.turn_on
        target: {entity_id: "{{ wl }}"}
        data: {rgb_color: [255, 197, 143], brightness_pct: 70}
    mode: single
    max_exceeded: silent
#endif
#if autopilot and notify
  # ── Notifications ─────────────────────────────────────────────────────────
  - id: ${P}_bedtime_preheat_notify
    alias: "Eight+ · ${NAME} · Bedtime pre-heat/pre-cool notify"
    triggers:
      - {trigger: time, at: input_datetime.${P}_bedtime}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_smart_autopilot, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
    actions:
      - delay: {seconds: 20}
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: "{{ 'Bed pre-heating' if state_attr('sensor.${P}_suggested_temp','preheat_bonus')|float(0) >= 0 else 'Bed pre-cooling' }}"
          message: >-
            {% set p = state_attr('sensor.${P}_suggested_temp','preheat_bonus')|float(0) %}{% set t = states('sensor.${P}_suggested_temp') %}{% set tout = state_attr('${WEATHER}','temperature') %}{% if p > 0.3 and tout is not none %}It's {{ tout }}° outside, so Autopilot is heating harder for bedtime — targeting {{ t }}°C.{% elif p < -0.3 and tout is not none %}It's {{ tout }}° outside, so Autopilot is cooling harder for bedtime — targeting {{ t }}°C.{% else %}Autopilot is applying your normal bedtime target — {{ t }}°C.{% endif %}
          data:
            tag: ${P}_bedtime_preheat
            group: pod
            actions:
              - {action: EP_${UP}_BOOST_WARM, title: Boost warmer}
              - {action: EP_${UP}_BOOST_COOL, title: Boost cooler}
    mode: single

  - id: ${P}_wake_preheat_notify
    alias: "Eight+ · ${NAME} · Wake pre-heat notify"
    triggers:
      - {trigger: time, at: input_datetime.${P}_wake}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_smart_autopilot, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
    actions:
      - delay: {seconds: 20}
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: Bed warming for wake
          message: "Autopilot is warming the bed for wake — targeting {{ states('sensor.${P}_suggested_temp') }}°C."
          data:
            tag: ${P}_wake_preheat
            group: pod
            actions:
              - {action: EP_${UP}_BOOST_WARM, title: Boost warmer}
              - {action: EP_${UP}_DISMISS, title: Looks good}
    mode: single

  - id: ${P}_bed_ready_notify
    alias: "Eight+ · ${NAME} · Bed ready notify"
    description: The bed reached its target (within 0.6°) for 2 min in the evening, before ${NAME} is in it. Once a night.
    triggers:
      - trigger: template
        value_template: >-
          {{ states('${CLIMATE}') not in ['off','unavailable','unknown'] and ((state_attr('${CLIMATE}','current_temperature') | float(-99)) - (state_attr('${CLIMATE}','temperature') | float(99))) | abs <= 0.6 }}
        for: {minutes: 2}
    conditions:
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_boost_active, state: "off"}
      - {condition: time, after: "17:00:00", before: "23:59:59"}
      - condition: template
        value_template: "{{ as_timestamp(this.attributes.last_triggered, 0) < as_timestamp(today_at('12:00')) }}"
    actions:
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: "🛏️ Bed's ready"
          message: >-
            {%- macro lvl(t) -%}{%- set lo = state_attr('${CLIMATE}','min_temp') | float(9) -%}{%- set hi = state_attr('${CLIMATE}','max_temp') | float(45) -%}{%- set l = (((t | float(27)) - lo) / (hi - lo) * 20 - 10) | round(0) | int -%}{{ ('+' ~ l) if l > 0 else (('−' ~ (-l)) if l < 0 else '0') }}{%- endmacro -%}{% set t = state_attr('${CLIMATE}','temperature') | float(27) %}Your side is at {{ t | round(0) | int }}° ({{ lvl(t) }}) — climb in whenever you're ready.
          data:
            tag: ${P}_bed_ready
            group: pod
            actions:
              - {action: EP_${UP}_COOLER, title: Cooler}
              - {action: EP_${UP}_WARMER, title: Warmer}
    mode: single

  - id: ${P}_morning_notify
    alias: "Eight+ · ${NAME} · Good morning notify"
    description: >-
      Good-morning summary when ${NAME} gets up (out of bed 10 min, 4 am–1 pm, after 3 h+ in
      bed, once a day). Uses last night's sleep score once the pipeline has rolled it up.
    triggers:
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, from: "on", to: "off", for: {minutes: 10}}
    conditions:
      - {condition: time, after: "04:00:00", before: "13:00:00"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - condition: template
        value_template: "{{ (as_timestamp(trigger.to_state.last_changed) - as_timestamp(trigger.from_state.last_changed)) >= 3 * 3600 }}"
      - condition: template
        value_template: "{{ as_timestamp(this.attributes.last_triggered, 0) < as_timestamp(today_at('00:00')) }}"
    actions:
      - variables:
          in_bed_min: "{{ ((as_timestamp(trigger.to_state.last_changed) - as_timestamp(trigger.from_state.last_changed)) / 60) | int }}"
          pod_on: "{{ ${ANY_ON} }}"
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: "☀️ Good morning"
          message: >-
            {% set s = '${SCORE}' %}{% set fresh = state_attr(s,'wake_date') == now().date() | string and states(s) | is_number %}{% if fresh %}{% set a = state_attr(s,'time_asleep_min') | int(0) %}Slept {{ a // 60 }}h {{ '%02d' % (a % 60) }}m · score {{ states(s) }}{% if state_attr(s,'efficiency_pct') %} · {{ state_attr(s,'efficiency_pct') | round(0) | int }}% efficient{% endif %}.{% else %}{{ in_bed_min // 60 }}h {{ '%02d' % (in_bed_min % 60) }}m in bed — your sleep report is on its way.{% endif %}{% set w = state_attr('${WEATHER}','temperature') %}{% if w is not none %} It's {{ w | round(0) | int }}° outside.{% endif %}{{ ' The bed is still on.' if pod_on and is_state('input_boolean.${P}_off_when_up','off') else '' }}
          data:
            tag: ${P}_morning
            group: pod
            url: ${DASH_URL}
            actions:
              - {action: EP_${UP}_OFF, title: Turn bed off}
    mode: single

  - id: ${P}_away_notify
    alias: "Eight+ · ${NAME} · Away mode notify"
    triggers:
      - {trigger: state, entity_id: ${AWAY}, from: "off", to: "on", id: "on"}
      - {trigger: state, entity_id: ${AWAY}, from: "on", to: "off", id: "off"}
    actions:
      - choose:
          - conditions: [{condition: trigger, id: "on"}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: "✈️ Away mode on"
                  message: Your side is paused and Autopilot is on hold.
                  data:
                    tag: ${P}_away
                    group: pod
                    actions:
                      - {action: EP_${UP}_AWAY_OFF, title: Turn off away}
          - conditions: [{condition: trigger, id: "off"}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: "🏠 Welcome back"
                  message: "Away mode is off — the bed is back on your schedule{{ ', Autopilot resumes tonight' if is_state('input_boolean.${P}_smart_autopilot','on') else '' }}."
                  data:
                    tag: ${P}_away
                    group: pod
                    actions:
                      - {action: EP_${UP}_ON, title: Turn bed on}
    mode: single

  - id: ${P}_goodnight_notify
    alias: "Eight+ · ${NAME} · Goodnight notify"
    description: Once ${NAME} has been in bed 10 min in the evening — tonight's temperature, Autopilot and wake time. Passive, once a night.
    triggers:
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, from: "off", to: "on", for: {minutes: 10}}
    conditions:
      - {condition: time, after: "20:00:00", before: "03:00:00"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - condition: template
        value_template: "{{ now().timestamp() - as_timestamp(this.attributes.last_triggered, 0) > 10 * 3600 }}"
    actions:
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ states('${CLIMATE}') not in ['off','unavailable','unknown'] }}"
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: "🌙 Goodnight, ${NAME}"
                  message: >-
                    {%- macro lvl(t) -%}{%- set lo = state_attr('${CLIMATE}','min_temp') | float(9) -%}{%- set hi = state_attr('${CLIMATE}','max_temp') | float(45) -%}{%- set l = (((t | float(27)) - lo) / (hi - lo) * 20 - 10) | round(0) | int -%}{{ ('+' ~ l) if l > 0 else (('−' ~ (-l)) if l < 0 else '0') }}{%- endmacro -%}{%- set wh = state_attr('input_datetime.${P}_wake','hour') | int(8) -%}{%- set wm = state_attr('input_datetime.${P}_wake','minute') | int(0) -%}{%- set wake = (today_at('00:00') + timedelta(hours=wh, minutes=wm)).strftime('%-I:%M %p') | lower -%}{% set t = state_attr('${CLIMATE}','temperature') | float(27) %}Bed at {{ t | round(0) | int }}° ({{ lvl(t) }}). {% if is_state('input_boolean.${P}_smart_autopilot','on') %}Autopilot has the night and warms you for {{ wake }}.{% else %}Autopilot is off, so it'll hold there.{% endif %}
                  data:
                    tag: ${P}_goodnight
                    group: pod
                    push: {interruption-level: passive}
                    actions:
                      - {action: EP_${UP}_COOLER, title: Cooler}
                      - {action: EP_${UP}_WARMER, title: Warmer}
        default:
          - action: ${NOTIFY}
            continue_on_error: true
            data:
              title: "🌙 Goodnight, ${NAME}"
              message: Your side of the bed is off tonight.
              data:
                tag: ${P}_goodnight
                group: pod
                push: {interruption-level: passive}
                actions:
                  - {action: EP_${UP}_ON, title: Turn bed on}
    mode: single

  - id: ${P}_autopilot_change_notify
    alias: "Eight+ · ${NAME} · Autopilot change notify"
    description: Quiet lock-screen note when Autopilot moves ${NAME}'s side by 1° or more. Passive, one replacing tag.
    triggers:
      - {trigger: state, entity_id: ${CLIMATE}, attribute: temperature}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_smart_autopilot, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_boost_active, state: "off"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - condition: template
        value_template: "{{ states('${CLIMATE}') not in ['off','unavailable','unknown'] }}"
      - condition: template
        value_template: "{{ trigger.from_state is not none and ((trigger.to_state.attributes.temperature | float(0)) - (trigger.from_state.attributes.temperature | float(0))) | abs >= 1 }}"
      - condition: template
        value_template: >-
          {{ states.automation | selectattr('attributes.id', 'defined') | selectattr('attributes.id', 'in', ['${P}_smart_autopilot_apply', '${P}_autopilot_schedule']) | map(attribute='attributes.last_triggered') | reject('none') | map('as_timestamp') | select('>', now().timestamp() - 90) | list | count > 0 }}
    actions:
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: "Autopilot {{ 'cooled' if (trigger.to_state.attributes.temperature | float(0)) < (trigger.from_state.attributes.temperature | float(0)) else 'warmed' }} your side"
          message: >-
            {%- macro lvl(t) -%}{%- set lo = state_attr('${CLIMATE}','min_temp') | float(9) -%}{%- set hi = state_attr('${CLIMATE}','max_temp') | float(45) -%}{%- set l = (((t | float(27)) - lo) / (hi - lo) * 20 - 10) | round(0) | int -%}{{ ('+' ~ l) if l > 0 else (('−' ~ (-l)) if l < 0 else '0') }}{%- endmacro -%}{% set a = trigger.from_state.attributes.temperature | float(27) %}{% set b = trigger.to_state.attributes.temperature | float(27) %}{% set ph = state_attr('sensor.${P}_suggested_temp','phase') %}{% set names = {'winddown':'Wind-down','bedtime':'Bedtime','early':'Early sleep','deep':'Deep sleep','late':'Late sleep','prewake':'Pre-wake','wake':'Wake'} %}{{ a | round(0) | int }}° → {{ b | round(0) | int }}° ({{ lvl(a) }} → {{ lvl(b) }}){% if ph %} · {{ names.get(ph, ph | title) }}{% endif %}
          data:
            tag: ${P}_autopilot
            group: pod
            push: {interruption-level: passive}
            actions:
              - {action: EP_${UP}_COOLER, title: Cooler}
              - {action: EP_${UP}_WARMER, title: Warmer}
    mode: single

  - id: ${P}_notify_actions
    alias: "Eight+ · ${NAME} · Notification buttons"
    description: >-
      What the buttons on ${NAME}'s bed notifications do. Warmer/Cooler stand Autopilot down
      first — the same rule the card's +/- follows — so a lock-screen nudge sticks. Boost
      warmer/cooler run 30 min at the extreme then hand back to Autopilot.
    triggers:
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_OFF}, id: "off"}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_ON}, id: "on"}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_WARMER}, id: warmer}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_COOLER}, id: cooler}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_AWAY_OFF}, id: away_off}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_BOOST_WARM}, id: boost_warm}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_BOOST_COOL}, id: boost_cool}
#if primary
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_PRIME}, id: prime}
#endif
    actions:
      - choose:
          - conditions: [{condition: trigger, id: "off"}]
            sequence:
              - action: climate.turn_off
                target: {entity_id: "{{ ${BEDS} }}"}
          - conditions: [{condition: trigger, id: "on"}]
            sequence:
              - action: climate.turn_on
                target: {entity_id: "{{ ${BEDS} }}"}
          - alias: Warmer — one degree, Autopilot stands down so it sticks
            conditions: [{condition: trigger, id: warmer}]
            sequence:
              - action: input_boolean.turn_off
                target: {entity_id: input_boolean.${P}_smart_autopilot}
              - action: climate.set_temperature
                target: {entity_id: "{{ ${BEDS} }}"}
                data:
                  temperature: "{{ [ (state_attr('${CLIMATE}','temperature') | float(27)) + 1, state_attr('${CLIMATE}','max_temp') | float(45) ] | min }}"
          - alias: Cooler — one degree, Autopilot stands down so it sticks
            conditions: [{condition: trigger, id: cooler}]
            sequence:
              - action: input_boolean.turn_off
                target: {entity_id: input_boolean.${P}_smart_autopilot}
              - action: climate.set_temperature
                target: {entity_id: "{{ ${BEDS} }}"}
                data:
                  temperature: "{{ [ (state_attr('${CLIMATE}','temperature') | float(27)) - 1, state_attr('${CLIMATE}','min_temp') | float(9) ] | max }}"
          - conditions: [{condition: trigger, id: away_off}]
            sequence:
              - action: input_boolean.turn_off
                target: {entity_id: ${AWAY}}
          - alias: Boost — 30 min at the extreme, then back to Autopilot
            conditions: [{condition: trigger, id: [boost_warm, boost_cool]}]
            sequence:
              - variables:
                  extreme: "{{ 40 if trigger.id == 'boost_warm' else 22 }}"
                  prev_temp: "{{ state_attr('${CLIMATE}','temperature') | float(29) }}"
              - action: climate.turn_on
                target: {entity_id: ${CLIMATE}}
              - action: input_datetime.set_datetime
                target: {entity_id: input_datetime.${P}_boost_until}
                data: {timestamp: "{{ now().timestamp() + 1800 }}"}
              - action: input_boolean.turn_on
                target: {entity_id: input_boolean.${P}_boost_active}
              - action: climate.set_temperature
                target: {entity_id: ${CLIMATE}}
                data: {temperature: "{{ extreme }}"}
              - delay: {minutes: 30}
              - action: input_boolean.turn_off
                target: {entity_id: input_boolean.${P}_boost_active}
              - action: climate.set_temperature
                target: {entity_id: ${CLIMATE}}
                data:
                  temperature: "{{ states('sensor.${P}_suggested_temp') | float(prev_temp) if is_state('input_boolean.${P}_smart_autopilot','on') else prev_temp }}"
#if primary
          - conditions: [{condition: trigger, id: prime}]
            sequence:
${PRIME_ACTION}
#endif
    mode: queued
    max: 6
#endif
#if primary and notify
  # ── Bed maintenance (primary sleeper only) ────────────────────────────────
  - id: ${P}_water_low_notify
    alias: "Eight+ · ${NAME} · Pod water low notify"
    triggers:
      - {trigger: state, entity_id: binary_sensor.eight_plus_water_low, to: "on", for: {minutes: 5}, id: low}
      - {trigger: state, entity_id: binary_sensor.eight_plus_water_low, from: "on", to: "off", for: {minutes: 2}, id: ok}
    actions:
      - choose:
          - conditions: [{condition: trigger, id: low}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: "💧 Pod water is low"
                  message: Top up the reservoir at the back of the Pod, then tap Prime now.
                  data:
                    tag: eight_plus_water
                    group: pod
                    push: {interruption-level: time-sensitive}
                    actions:
                      - {action: EP_PRIME, title: Prime now}
          - conditions: [{condition: trigger, id: ok}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  message: clear_notification
                  data: {tag: eight_plus_water}
    mode: single

  - id: ${P}_priming_notify
    alias: "Eight+ · ${NAME} · Pod priming notify"
    triggers:
      - {trigger: state, entity_id: binary_sensor.eight_plus_priming, from: "off", to: "on", id: start}
      - {trigger: state, entity_id: binary_sensor.eight_plus_priming, from: "on", to: "off", for: {minutes: 1}, id: done}
    actions:
      - choose:
          - conditions: [{condition: trigger, id: start}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: Priming the Pod
                  message: Takes about 12 minutes and it'll gurgle a bit. Temperature control pauses until it's done.
                  data:
                    tag: eight_plus_priming
                    group: pod
                    push: {interruption-level: passive}
          - conditions: [{condition: trigger, id: done}]
            sequence:
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  message: clear_notification
                  data: {tag: eight_plus_water}
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  title: Priming done
                  message: "{% set m = ((as_timestamp(trigger.to_state.last_changed) - as_timestamp(trigger.from_state.last_changed)) / 60) | round(0) | int %}Finished in {{ m }} min — the Pod is back to normal."
                  data:
                    tag: eight_plus_priming
                    group: pod
                    actions:
                      - {action: EP_${UP}_ON, title: Turn bed on}
    mode: queued
#endif
#if coach
  # ── Sleep Coach ───────────────────────────────────────────────────────────
  - id: ${P}_coach_target
    alias: "Eight+ · ${NAME} · Coach — tonight's target"
    description: >-
      Writes tonight's asleep-by target: the plain target, pulled earlier by up to 30 min when
      there's sleep debt (never before 9:30 pm). Also resets the night's nudge counter, the
      one-night opt-out and yesterday's I'm-up. Runs at 6 pm and whenever a target is edited.
    triggers:
      - {trigger: time, at: "18:00:00"}
      - trigger: state
        entity_id:
          - input_datetime.${P}_target_bedtime
          - input_datetime.${P}_target_bedtime_weekend
          - input_number.${P}_sleep_need
          - input_boolean.${P}_pull_earlier
      - {trigger: homeassistant, event: start}
    actions:
      - alias: Write tonight's target (floored at 9:30 pm)
        action: input_datetime.set_datetime
        target: {entity_id: input_datetime.${P}_coach_tonight_target}
        data:
          time: "{% set t = [plain_ts | int - (pull_min | int) * 60, 21 * 3600 + 1800] | max %}{{ '%02d:%02d:00' % ((t // 3600) % 24, (t % 3600) // 60) }}"
      - action: counter.reset
        target: {entity_id: counter.${P}_coach_nudges}
      - action: input_boolean.turn_off
        target:
          entity_id:
            - input_boolean.${P}_coach_off_tonight
            - input_boolean.${P}_wake_ack
    mode: queued
    max: 5
    variables:
      plain_ts: "{{ state_attr('input_datetime.${P}_target_bedtime_weekend' if now().weekday() in [4, 5] else 'input_datetime.${P}_target_bedtime', 'timestamp') | int(0) }}"
      pull_min: "{{ [30, ((state_attr('${SCORE}', 'coach') or {}).get('debt_min', 0) | int(0) / 6) | round(0) | int] | min if is_state('input_boolean.${P}_pull_earlier','on') else 0 }}"

  - id: ${P}_routine_coach_sync
    alias: "Eight+ · ${NAME} · Routine ↔ Coach targets sync"
    description: >-
      One set of times: the Coach's four targets mirror the weekly routine. Editing either side
      copies to the other; on HA start the routine wins. Copies only when values differ, so the
      two directions can't ping-pong.
    triggers:
      - trigger: state
        entity_id:
          - input_datetime.${P}_weekday_bedtime
          - input_datetime.${P}_weekend_bedtime
          - input_datetime.${P}_weekday_alarm
          - input_datetime.${P}_weekend_alarm
        id: routine
      - trigger: state
        entity_id:
          - input_datetime.${P}_target_bedtime
          - input_datetime.${P}_target_bedtime_weekend
          - input_datetime.${P}_target_wake
          - input_datetime.${P}_target_wake_weekend
        id: coach
      - {trigger: homeassistant, event: start, id: boot}
    actions:
      - repeat:
          for_each: "{{ pairs }}"
          sequence:
            - variables:
                src: "{{ repeat.item[1] if trigger.id == 'coach' else repeat.item[0] }}"
                dst: "{{ repeat.item[0] if trigger.id == 'coach' else repeat.item[1] }}"
            - if:
                - condition: template
                  value_template: "{{ states(src) not in ['unknown', 'unavailable'] and states(src) != states(dst) }}"
              then:
                - action: input_datetime.set_datetime
                  target: {entity_id: "{{ dst }}"}
                  data: {time: "{{ states(src) }}"}
    mode: queued
    max: 10
    variables:
      pairs:
        - [input_datetime.${P}_weekday_bedtime, input_datetime.${P}_target_bedtime]
        - [input_datetime.${P}_weekend_bedtime, input_datetime.${P}_target_bedtime_weekend]
        - [input_datetime.${P}_weekday_alarm, input_datetime.${P}_target_wake]
        - [input_datetime.${P}_weekend_alarm, input_datetime.${P}_target_wake_weekend]

  - id: ${P}_wake_warm
    alias: "Eight+ · ${NAME} · Wake-up — warm the bed"
    description: >-
      20 min before the wake target the bed warms toward the wake level. Holds Autopilot off
      (boost_active until wake + 30 min) so the apply loop doesn't undo the wake heat.
    triggers:
      - trigger: time
        at: {entity_id: input_datetime.${P}_target_wake, offset: "-00:20:00"}
        id: weekday
      - trigger: time
        at: {entity_id: input_datetime.${P}_target_wake_weekend, offset: "-00:20:00"}
        id: weekend
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_wake_heat, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - condition: not
        conditions: [{condition: state, entity_id: input_select.${P}_wake_strength, state: "Off"}]
      - alias: Only the trigger that matches today (weekend = Sat/Sun morning)
        condition: or
        conditions:
          - condition: and
            conditions:
              - {condition: trigger, id: weekday}
              - {condition: time, weekday: [mon, tue, wed, thu, fri]}
          - condition: and
            conditions:
              - {condition: trigger, id: weekend}
              - {condition: time, weekday: [sat, sun]}
      - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "on"}
    actions:
      - alias: Hold Autopilot off while the wake heat runs
        action: input_boolean.turn_on
        target: {entity_id: input_boolean.${P}_boost_active}
      - action: input_datetime.set_datetime
        target: {entity_id: input_datetime.${P}_boost_until}
        data: {timestamp: "{{ (now() + timedelta(minutes=50)).timestamp() | int }}"}
      - action: climate.turn_on
        target: {entity_id: "{{ ${BEDS} }}"}
      - action: climate.set_temperature
        target: {entity_id: "{{ ${BEDS} }}"}
        data: {temperature: "{{ [states('input_number.${P}_wake_level') | float(38), 42] | min }}"}
    mode: single

  - id: ${P}_wake_proof
    alias: "Eight+ · ${NAME} · Wake-up — proof they're up"
    description: The bed empty for 3 minutes in the morning counts as proof — ends the wake escalation.
    triggers:
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, to: "off", for: {minutes: 3}}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: time, after: "03:30:00", before: "12:00:00"}
    actions:
      - action: input_boolean.turn_on
        target: {entity_id: input_boolean.${P}_wake_ack}
#if notify
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          message: clear_notification
          data: {tag: ${P}_wake}
#endif
    mode: single
#endif
#if coach and notify

  - id: ${P}_coach_winddown
    alias: "Eight+ · ${NAME} · Coach — wind-down"
    description: Fires when the coach enters the wind-down window — runs the wind-down script and says so. Silent if already in bed.
    triggers:
      - {trigger: state, entity_id: sensor.${P}_coach_status, to: drifting}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_nudge_winddown, state: "on"}
      - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "off"}
    actions:
      - action: script.turn_on
        target: {entity_id: script.${P}_wind_down}
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: Wind-down
          message: "{% from 'eight_plus.jinja' import hm12 %}The bed's getting ready. Aim to be in bed by {{ hm12(state_attr('sensor.${P}_coach_status','target')) }}."
          data:
            tag: ${P}_coach
            channel: Sleep coach
            actions:
              - {action: EP_${UP}_COACH_ON_MY_WAY, title: Heading up}
              - {action: EP_${UP}_COACH_OFF_TONIGHT, title: Not tonight}
    mode: single

  - id: ${P}_coach_pre
    alias: "Eight+ · ${NAME} · Coach — 15 minutes to go"
    triggers:
      - trigger: time
        at: {entity_id: input_datetime.${P}_coach_tonight_target, offset: "-00:15:00"}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_nudge_pre, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "off"}
    actions:
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          title: 15 minutes to bedtime
          message: >-
            {% from 'eight_plus.jinja' import hm12 %}{% if debt_min | int > 30 %}You're {{ (debt_min | int / 60) | round(1) }}h down. Tonight's the night to claw some back.{% else %}Lights out at {{ hm12(state_attr('sensor.${P}_coach_status','target')) }} keeps you level.{% endif %}
          data:
            tag: ${P}_coach
            channel: Sleep coach
            actions:
              - {action: EP_${UP}_COACH_ON_MY_WAY, title: Heading up}
              - {action: EP_${UP}_COACH_SNOOZE_15, title: Snooze 15}
      - action: counter.increment
        target: {entity_id: counter.${P}_coach_nudges}
    mode: single
    variables:
      debt_min: "{{ (state_attr('${SCORE}', 'coach') or {}).get('debt_min', 0) | int(0) }}"

  - id: ${P}_coach_late
    alias: "Eight+ · ${NAME} · Coach — you're not in bed"
    description: >-
      At tonight's target, then every 30 min while still up — three messages in all, then
      silence. The loop ends the moment the bed says they're in it.
    triggers:
      - trigger: time
        at: {entity_id: input_datetime.${P}_coach_tonight_target}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "off"}
      - {condition: state, entity_id: input_boolean.${P}_nudge_late, state: "on"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
    actions:
      - repeat:
          sequence:
            - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "off"}
            - variables:
                loud: "{{ is_state('input_boolean.${P}_nudge_loud','on') and repeat.index > 1 }}"
            - action: ${NOTIFY}
              continue_on_error: true
              data:
                title: "{{ 'Still up' if repeat.index > 1 else \"You're not in bed\" }}"
                message: >-
                  {% from 'eight_plus.jinja' import hm12 %}{% set wake = state_attr('sensor.${P}_coach_status','wake') %}{% set wm = (wake.split(':')[0]|int)*60 + (wake.split(':')[1]|int) %}{% set n = now().hour*60 + now().minute %}{% set best = ((wm - n) % 1440) %}Your {{ hm12(wake) }} wake isn't moving — that's {{ (best // 60) }}h {{ '%02d' % (best % 60) }}m at best from now.
                data:
                  tag: ${P}_coach
                  channel: Sleep coach
                  importance: "{{ 'high' if loud else 'default' }}"
                  ttl: 0
                  priority: "{{ 'high' if loud else 'normal' }}"
                  push:
                    interruption-level: "{{ 'time-sensitive' if loud else 'active' }}"
                  actions:
                    - {action: EP_${UP}_COACH_ON_MY_WAY, title: On my way}
                    - {action: EP_${UP}_COACH_OFF_TONIGHT, title: Let me off}
            - action: counter.increment
              target: {entity_id: counter.${P}_coach_nudges}
            - delay: {minutes: 30}
          until:
            - condition: or
              conditions:
                - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "on"}
                - {condition: numeric_state, entity_id: counter.${P}_coach_nudges, above: 2}
                - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "on"}
    mode: restart

  - id: ${P}_coach_in_bed
    alias: "Eight+ · ${NAME} · Coach — in bed, stop"
    triggers:
      - {trigger: state, entity_id: binary_sensor.${P}_in_bed, to: "on"}
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
    actions:
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          message: clear_notification
          data: {tag: ${P}_coach}
      - action: counter.set_value
        target: {entity_id: counter.${P}_coach_nudges}
        data: {value: 3}
    mode: single

  - id: ${P}_coach_actions
    alias: "Eight+ · ${NAME} · Coach — notification buttons"
    triggers:
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_COACH_ON_MY_WAY}, id: on_my_way}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_COACH_SNOOZE_15}, id: snooze}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_COACH_OFF_TONIGHT}, id: off_tonight}
      - {trigger: event, event_type: mobile_app_notification_action, event_data: {action: EP_${UP}_COACH_IM_UP}, id: im_up}
    actions:
      - choose:
          - alias: Heading up — hold the nudges
            conditions: [{condition: trigger, id: on_my_way}]
            sequence:
              - action: counter.set_value
                target: {entity_id: counter.${P}_coach_nudges}
                data: {value: 3}
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  message: clear_notification
                  data: {tag: ${P}_coach}
          - alias: Snooze 15 — move tonight's target
            conditions: [{condition: trigger, id: snooze}]
            sequence:
              - action: input_datetime.set_datetime
                target: {entity_id: input_datetime.${P}_coach_tonight_target}
                data:
                  time: "{% set t = (state_attr('input_datetime.${P}_coach_tonight_target','timestamp') | int(0) + 900) % 86400 %}{{ '%02d:%02d:00' % (t // 3600, (t % 3600) // 60) }}"
          - alias: Let me off — one night, no nudges, no escalation
            conditions: [{condition: trigger, id: off_tonight}]
            sequence:
              - action: input_boolean.turn_on
                target: {entity_id: input_boolean.${P}_coach_off_tonight}
              - action: ${NOTIFY}
                continue_on_error: true
                data:
                  message: clear_notification
                  data: {tag: ${P}_coach}
          - alias: I'm up — ends the wake escalation
            conditions: [{condition: trigger, id: im_up}]
            sequence:
              - action: input_boolean.turn_on
                target: {entity_id: input_boolean.${P}_wake_ack}
    mode: queued
    max: 5

  - id: ${P}_wake_escalate
    alias: "Eight+ · ${NAME} · Wake-up — escalate until they're up"
    description: >-
      At the wake target: an alert with an I'm up button, then every few minutes a firmer step
      (cold snap, then sound) until the bed has been empty 3 min or I'm up is tapped. Gives up
      after 25 min. Gentle = one alert; Relentless = every 3 min instead of 4.
    triggers:
      - trigger: time
        at: {entity_id: input_datetime.${P}_target_wake}
        id: weekday
      - trigger: time
        at: {entity_id: input_datetime.${P}_target_wake_weekend}
        id: weekend
    conditions:
      - {condition: state, entity_id: input_boolean.${P}_coach, state: "on"}
      - {condition: state, entity_id: input_boolean.${P}_coach_off_tonight, state: "off"}
      - {condition: state, entity_id: ${AWAY}, state: "off"}
      - condition: not
        conditions: [{condition: state, entity_id: input_select.${P}_wake_strength, state: "Off"}]
      - condition: or
        conditions:
          - condition: and
            conditions:
              - {condition: trigger, id: weekday}
              - {condition: time, weekday: [mon, tue, wed, thu, fri]}
          - condition: and
            conditions:
              - {condition: trigger, id: weekend}
              - {condition: time, weekday: [sat, sun]}
    actions:
      - action: input_boolean.turn_off
        target: {entity_id: input_boolean.${P}_wake_ack}
      - repeat:
          sequence:
            - {condition: state, entity_id: input_boolean.${P}_wake_ack, state: "off"}
#if gateway
            - alias: Bed vibration on this side while they're still in bed
              if:
                - {condition: state, entity_id: input_boolean.${P}_wake_vibrate, state: "on"}
                - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "on"}
              then:
                - action: mqtt.publish
                  data:
                    topic: eightpod/ctl/cmd/${SIDE}_alarm
                    payload: "{{ {'power': vib_power | int, 'duration': 30, 'pattern': ('rise' if repeat.index == 1 else 'double')} | to_json }}"
#endif
            - choose:
                - alias: Round 1 — the alert
                  conditions: ["{{ repeat.index == 1 }}"]
                  sequence:
                    - {condition: state, entity_id: input_boolean.${P}_wake_phone, state: "on"}
                    - action: ${NOTIFY}
                      continue_on_error: true
                      data:
                        title: Time to get up
                        message: "{% from 'eight_plus.jinja' import hm12 %}It's {{ hm12(now().strftime('%H:%M')) }}. The bed's warm."
                        data:
                          tag: ${P}_wake
                          channel: Sleep coach
                          importance: high
                          priority: high
                          ttl: 0
                          push: {interruption-level: time-sensitive}
                          actions:
                            - {action: EP_${UP}_COACH_IM_UP, title: "I'm up"}
                - alias: Round 3 — the cold snap
                  conditions:
                    - "{{ repeat.index == 3 }}"
                    - {condition: state, entity_id: input_boolean.${P}_wake_cold, state: "on"}
                    - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "on"}
                  sequence:
                    - action: climate.set_temperature
                      target: {entity_id: ${CLIMATE}}
                      data: {temperature: 15}
                    - delay: {minutes: 3}
                    - action: climate.set_temperature
                      target: {entity_id: ${CLIMATE}}
                      data: {temperature: "{{ [states('input_number.${P}_wake_level') | float(38), 42] | min }}"}
                - alias: Round 4 — sound
                  conditions:
                    - "{{ repeat.index == 4 }}"
                    - {condition: state, entity_id: input_boolean.${P}_wake_sound, state: "on"}
                  sequence:
                    - action: ${NOTIFY}
                      continue_on_error: true
                      data:
                        message: Still in bed. That's the last word from me.
                        data:
                          tag: ${P}_wake
                          channel: Sleep coach
                          importance: high
                          push: {interruption-level: time-sensitive}
                          actions:
                            - {action: EP_${UP}_COACH_IM_UP, title: "I'm up"}
              default:
                - action: ${NOTIFY}
                  continue_on_error: true
                  data:
                    title: Still in bed
                    message: "{% from 'eight_plus.jinja' import hm12 %}{{ hm12(now().strftime('%H:%M')) }} — that's {{ repeat.index * (gap_min | int) }} minutes past."
                    data:
                      tag: ${P}_wake
                      channel: Sleep coach
                      importance: high
                      push: {interruption-level: time-sensitive}
                      actions:
                        - {action: EP_${UP}_COACH_IM_UP, title: "I'm up"}
            - delay: {minutes: "{{ gap_min | int }}"}
          until:
            - condition: or
              conditions:
                - {condition: state, entity_id: input_boolean.${P}_wake_ack, state: "on"}
                - {condition: state, entity_id: binary_sensor.${P}_in_bed, state: "off", for: {minutes: 3}}
                - "{{ repeat.index >= (max_rounds | int) }}"
      - action: ${NOTIFY}
        continue_on_error: true
        data:
          message: clear_notification
          data: {tag: ${P}_wake}
#if gateway
      - alias: Stop any vibration still running
        action: mqtt.publish
        data: {topic: eightpod/ctl/cmd/${SIDE}_alarm, payload: "off"}
#endif
      - alias: Hand the bed back to Autopilot
        action: input_boolean.turn_off
        target: {entity_id: input_boolean.${P}_boost_active}
    mode: restart
    variables:
      gap_min: "{{ 3 if is_state('input_select.${P}_wake_strength','Relentless') else 4 }}"
      max_rounds: "{{ 1 if is_state('input_select.${P}_wake_strength','Gentle') else 6 }}"
      vib_power: "{{ {'Gentle': 30, 'Firm': 60, 'Relentless': 100}.get(states('input_select.${P}_wake_strength'), 60) }}"
#endif
