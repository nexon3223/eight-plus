{#-
  Eight+ — shared Jinja macros. GENERATED by the Eight+ add-on; rewritten on update.

  es_suggest(pfx, bedrate, weather, troom, hroom, roomrate)
    The Smart Autopilot model. Returns a JSON object: `state` (the suggested bed °C) plus
    every explain-attribute the card's Autopilot tab reads.

      pfx      helper prefix, e.g. "eight_sleep_alex"
      bedrate  that side's bed-temperature derivative sensor (°C/h)
      weather  a weather entity (outside temperature), or '' to skip that term
      troom    room temperature sensor, or ''
      hroom    room humidity sensor, or ''
      roomrate room-temperature derivative sensor (°C/h), or ''

    Reads these tuning helpers — each falls back to a built-in default if it's missing:
      input_select.<pfx>_autopilot_response        Gentle | Balanced | Eager
      input_number.<pfx>_autopilot_min / _max      hard clamp, default 22 / 40
      input_number.<pfx>_ap_offset_<phase>         per-phase offset
      input_boolean.<pfx>_ap_use_forecast / _room / _humidity / _reactive / _preconditioning
      input_number.<pfx>_smart_bias                explicit user offset (always applied)

  hm12(t)  "21:30" or "21:30:00" -> "9:30 pm" (notification copy is 12-hour).
-#}
{% macro hm12(t) -%}
{%- set p = (t | string).split(':') -%}
{%- if p | count >= 2 and p[0] | int(-1) >= 0 -%}
{%- set h = p[0] | int -%}{%- set m = p[1] | int(0) -%}
{{ (h % 12 if h % 12 else 12) ~ ':' ~ ('%02d' % m) ~ (' am' if h < 12 else ' pm') }}
{%- else -%}{{ t }}{%- endif -%}
{%- endmacro %}

{% macro es_suggest(pfx, bedrate, weather='', troom='', hroom='', roomrate='') %}
{%- set Tout    = state_attr(weather, 'temperature') | float(15) if weather else 15 -%}
{%- set Troom   = states(troom) | float(22) if troom else 22 -%}
{%- set Hroom   = states(hroom) | float(45) if hroom else 45 -%}
{%- set roomRate = states(roomrate) | float(0) if roomrate else 0 -%}
{#- a °F Home Assistant reports weather and room sensors in °F; the model works in °C
    (the add-on writes true/false here at install from the system's unit) -#}
{%- if __EP_IMPERIAL__ -%}
{%- set Tout = (Tout - 32) * 5 / 9 if weather else Tout -%}
{%- set Troom = (Troom - 32) * 5 / 9 if troom else Troom -%}
{%- set roomRate = roomRate * 5 / 9 -%}
{%- endif -%}
{%- set m = now().month -%}
{#- seasons flip below the equator (home zone latitude) -#}
{%- set south = state_attr('zone.home', 'latitude') | float(1) < 0 -%}
{%- set mm = ((m + 5) % 12) + 1 if south else m -%}
{%- set season = -3 if mm in [12,1,2] else (3 if mm in [6,7,8] else (-0.5 if mm in [3,4,5] else 0.5)) -%}

{%- set respRaw = states('input_select.' ~ pfx ~ '_autopilot_response') -%}
{%- set resp = respRaw if respRaw in ['Gentle','Balanced','Eager'] else 'Balanced' -%}
{%- set respMul = 0.5 if resp == 'Gentle' else (1.5 if resp == 'Eager' else 1.0) -%}

{%- set loRaw = states('input_number.' ~ pfx ~ '_autopilot_min') | float(none) -%}
{%- set hiRaw = states('input_number.' ~ pfx ~ '_autopilot_max') | float(none) -%}
{%- set clampLo = loRaw if loRaw is not none else 22 -%}
{%- set clampHi = hiRaw if hiRaw is not none else 40 -%}
{%- if clampLo >= clampHi -%}{%- set clampLo = 22 -%}{%- set clampHi = 40 -%}{%- endif -%}

{%- set useFc  = weather and states('input_boolean.' ~ pfx ~ '_ap_use_forecast') != 'off' -%}
{%- set useRm  = troom and states('input_boolean.' ~ pfx ~ '_ap_use_room') != 'off' -%}
{%- set useHm  = hroom and states('input_boolean.' ~ pfx ~ '_ap_use_humidity') != 'off' -%}
{%- set useRe  = roomrate and states('input_boolean.' ~ pfx ~ '_ap_use_reactive') != 'off' -%}
{%- set usePre = states('input_boolean.' ~ pfx ~ '_ap_use_preconditioning') != 'off' -%}

{#- ---- environmental baseline ---- -#}
{%- set outsideAdj = (([[ (16 - Tout) * 0.45, 5]|min, -5]|max) * respMul) if useFc else 0 -%}
{%- set roomAdj    = (([[ (20 - Troom) * 0.35, 3.5]|min, -3.5]|max) * respMul) if useRm else 0 -%}
{%- set humidAdj   = (([[ (50 - Hroom) * 0.03, 1.5]|min, -1.5]|max) * respMul) if useHm else 0 -%}
{%- set bias = states('input_number.' ~ pfx ~ '_smart_bias') | float(0) -%}
{%- set envBase = 29 + season + outsideAdj + roomAdj + humidAdj + bias -%}

{#- ---- phase schedule (default adj, overridden per-phase by helpers) ---- -#}
{%- set defs = {'bedtime':2,'winddown':1,'early':0.5,'late':-1,'deep':-2.5,'prewake':0.5,'wake':2} -%}
{%- set order = ['bedtime','winddown','early','late','deep','prewake','wake'] -%}
{%- set ph = namespace(list=[]) -%}
{%- for k in order -%}
  {%- set ov = states('input_number.' ~ pfx ~ '_ap_offset_' ~ k) | float(none) -%}
  {%- set ph.list = ph.list + [[k, (ov if ov is not none else defs[k])]] -%}
{%- endfor -%}
{%- set phases = ph.list -%}

{%- set btm = (state_attr('input_datetime.' ~ pfx ~ '_' ~ phases[0][0],'timestamp')|float(0)/60)|int -%}
{%- set cur = now().hour*60 + now().minute -%}
{%- set relcur = (cur - btm + 1440) % 1440 -%}
{%- set ns = namespace(adj=phases[-1][1], phase=phases[-1][0], idx=6) -%}
{%- for p in phases -%}
  {%- set pm = (state_attr('input_datetime.' ~ pfx ~ '_' ~ p[0],'timestamp')|float(0)/60)|int -%}
  {%- set rp = (pm - btm + 1440) % 1440 -%}
  {%- if relcur >= rp -%}{%- set ns.adj = p[1] -%}{%- set ns.phase = p[0] -%}{%- set ns.idx = loop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- set baseAdj = ns.adj -%}

{#- ---- predictive pre-conditioning: ramp toward the NEXT phase early ---- -#}
{%- set leadMin = namespace(v=0) -%}
{%- if usePre and ns.idx < 6 -%}
  {%- set nextP = phases[ns.idx + 1] -%}
  {%- set curPm = (state_attr('input_datetime.' ~ pfx ~ '_' ~ ns.phase,'timestamp')|float(0)/60)|int -%}
  {%- set curRp = (curPm - btm + 1440) % 1440 -%}
  {%- set nextPm = (state_attr('input_datetime.' ~ pfx ~ '_' ~ nextP[0],'timestamp')|float(0)/60)|int -%}
  {%- set nextRp = (nextPm - btm + 1440) % 1440 -%}
  {%- set prevSpan = (nextRp - curRp + 1440) % 1440 -%}
  {%- set deltaAdj = nextP[1] - ns.adj -%}
  {%- if deltaAdj|abs >= 0.3 -%}
    {%- set bedRateNow = states(bedrate)|float(0) -%}
    {%- set dirRate = (bedRateNow if bedRateNow > 0.5 else 9) if deltaAdj > 0 else ((0 - bedRateNow) if bedRateNow < -0.5 else 7.2) -%}
    {%- set rawLead = (deltaAdj|abs) / (dirRate / 60) -%}
    {%- set leadMin.v = [[rawLead, 90]|min, [prevSpan - 5, 0]|max]|min -%}
  {%- endif -%}
  {%- set rampStart = nextRp - leadMin.v -%}
  {%- if leadMin.v > 0 and relcur >= rampStart and relcur < nextRp -%}
    {%- set frac = (relcur - rampStart) / leadMin.v -%}
    {%- set ns.adj = ns.adj + (nextP[1] - ns.adj) * frac -%}
  {%- endif -%}
{%- endif -%}

{#- ---- reactive boost + bedtime preheat ---- -#}
{%- set boost = (([[ (0 - roomRate) * 0.15, 2.5]|min, -2.5]|max) * respMul) if useRe else 0 -%}
{%- set preheatBonus = (([[ (16 - Tout) * 0.3, 3]|min, -3]|max) * respMul) if (ns.phase == 'bedtime' and useFc) else 0 -%}

{%- set sug = envBase + ns.adj + boost + preheatBonus -%}
{%- set final = [[ sug, clampHi]|min, clampLo]|max -%}
{#- 0.1° resolution: the Pod stores whole °F (~0.56 °C) and snaps; the apply automation's
    deadband decides what is worth sending. -#}
{{- {
  'state': ((final | round(1)) | int if (final | round(1)) == ((final | round(1)) | int) else (final | round(1))),
  'env_base': (envBase | round(1)),
  'rate': (roomRate | round(2)),
  'lead_min': (leadMin.v | round(1)),
  'boost': (boost | round(2)),
  'phase': ns.phase,
  'phase_adj': (baseAdj | round(2)),
  'ramped_adj': (ns.adj | round(2)),
  'preheat_bonus': (preheatBonus | round(2)),
  'response': resp,
  'clamp_lo': clampLo,
  'clamp_hi': clampHi
} | to_json -}}
{%- endmacro %}
